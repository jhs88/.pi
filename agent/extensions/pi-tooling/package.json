{
  "name": "pi-tooling-extensions",
  "private": true,
  "type": "module",
  "pi": {
    "extensions": ["./index.ts"]
  },
  "scripts": {
    "check": "tsc --noEmit -p .",
    "test": "node --test --experimental-strip-types ask-user/*.test.ts background-terminals/*.test.ts file-search/*.test.ts firecrawl/*.test.ts integration/*.test.ts shared/*.test.ts workflows/*.test.ts",
    "verify": "npm run check && npm test",
    "prepare": "effect-tsgo patch"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.80.10",
    "@earendil-works/pi-coding-agent": "0.80.10",
    "@earendil-works/pi-tui": "0.80.10",
    "@effect/platform-node": "4.0.0-beta.98",
    "@effect/platform-node-shared": "4.0.0-beta.98",
    "acorn": "8.17.0",
    "effect": "4.0.0-beta.98",
    "firecrawl": "4.30.0",
    "typebox": "1.3.6"
  },
  "devDependencies": {
    "@effect/tsgo": "0.19.0",
    "@types/node": "26.1.1",
    "typescript": "7.0.2"
  }
}
