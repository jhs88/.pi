{
  "mcpServers": {
    "cachebro": {
      "args": [
        "-y",
        "cachebro",
        "serve"
      ],
      "command": "npx",
      "env": {
        "CACHEBRO_DIR": "${HOME}/.cache/cachebro"
      },
      "directTools": [
        "read_file",
        "read_files"
      ]
    },
    "grepika": {
      "args": [
        "-y",
        "@agentika/grepika",
        "--mcp",
        "--root",
        "."
      ],
      "command": "npx",
      "directTools": [
        "toc",
        "outline",
        "search",
        "get"
      ]
    },
    "tilth": {
      "args": [
        "-y",
        "tilth",
        "--mcp",
        "--edit"
      ],
      "command": "npx",
      "directTools": [
        "tilth_search",
        "tilth_read"
      ]
    }
  }
}
