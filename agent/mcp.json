{
  "mcpServers": {
    "grepika": {
      "args": [
        "-y",
        "@agentika/grepika",
        "--mcp",
        "--root",
        "."
      ],
      "command": "npx",
      "exposure": "codemode",
      "toolExposure": {
        "toc": "direct",
        "outline": "direct",
        "search": "direct",
        "get": "direct"
      }
    },
    "tilth": {
      "args": [
        "-y",
        "tilth",
        "--mcp",
        "--edit"
      ],
      "command": "npx",
      "exposure": "codemode",
      "toolExposure": {
        "tilth_search": "direct",
        "tilth_read": "direct"
      }
    },
    "firecrawl": {
      "command": "npx",
      "args": [
        "-y",
        "firecrawl-mcp"
      ],
      "env": {
        "FIRECRAWL_API_URL": "http://172.16.8.179:3002"
      },
      "exposure": "codemode"
    }
  }
}
